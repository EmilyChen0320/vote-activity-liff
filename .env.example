# 本機開發用：複製成 .env.local 後填入要測試的活動
# 正式環境這些值由後端 Blade 頁面外殼注入 window.endpoint，不走這裡

# LINE CRM API 位址（不含結尾斜線）
VITE_DEV_LINE_CRM_API_BASE_URL=https://feature-line-crm.aitago.tw
# 要開啟的投票活動 ID（ULID，可從後台活動連結取得）
VITE_DEV_VOTE_ACTIVITY_ID=
# 需要 LINE 登入的活動才需要填，並把 VITE_DEV_ENABLE_LIFF 設為 true
VITE_DEV_LIFF_ID=
VITE_DEV_BASIC_ID=
VITE_DEV_ENABLE_LIFF=false
# 導覽列顯示的官方帳號／節目名稱（正式環境由後端外殼注入）
VITE_DEV_OA_NAME=請世界吃桌
